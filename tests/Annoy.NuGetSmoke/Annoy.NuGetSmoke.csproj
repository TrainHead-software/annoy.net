<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AnnoyPackageVersion Condition="'$(AnnoyPackageVersion)' == ''">0.0.0-local</AnnoyPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Annoy.Net" Version="$(AnnoyPackageVersion)" />
  </ItemGroup>
</Project>
